# Postgres connection (Supabase or any Postgres). Use the pooled/pgbouncer
# URL for the Netlify Function runtime; a direct connection for migrations.
DATABASE_URL="postgresql://user:password@host:5432/booker?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/booker"

# JWT signing secrets — generate with `openssl rand -hex 32`. MUST be set
# in production; the code falls back to insecure dev defaults otherwise.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Supabase Realtime Broadcast (optional — cross-screen "please refresh" pings)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

NODE_ENV="development"

# Password-reset / transactional email (optional). Without these, the
# forgot-password flow still works but logs the email instead of sending it —
# fine for local dev, get real values before relying on it in production.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
APP_URL="http://localhost:5173"

# Online payment for guest QR self-ordering (optional). Without these, guests
# can still order but only pay in-person — the "pay online" button on the
# guest ordering page simply won't appear. Get test keys free at
# https://dashboard.razorpay.com/app/keys (test mode, no real money moves).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
